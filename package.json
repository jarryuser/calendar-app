{
  "name": "calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pages:dev": "npx wrangler pages dev --d1 DB=calendar-db --proxy 5173",
    "pages:deploy": "npm run build && npx wrangler pages deploy",
    "test": "node tests/run.mjs",
    "test:api": "node tests/start-api.mjs",
    "test:e2e": "playwright test",
    "backup:d1": "node scripts/d1-backup.mjs",
    "check:backup": "node scripts/check-backup.mjs",
    "db:migrate:local": "wrangler d1 migrations apply calendar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply calendar-db --remote"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tauri-apps/api": "^2.11.0",
    "chrono-node": "^2.7.6",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "ical.js": "^1.5.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "rrule": "^2.8.1",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
